// shaders/raytrace.comp
#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform image2D outputImage;
uniform sampler2D u_input;

uniform float u_r;           // sphere radius
uniform float u_n;           // refractive index
uniform float u_a;           // source plane distance
uniform float u_b;           // screen distance
uniform vec2  u_resolution;

const float screenSize = 1.0;
const float objectSize = 0.5;


float dotProduct(vec3 a, vec3 b){
    return 1.0 * (a.x * b.x + a.y * b.y + a.z * b.z);
}

//todo
vec3 refractRay(vec3 d, vec3 normal, float n1, float n2) {
    float cosI  = -dot(normal, d);               // cos(θ1) — how aligned ray is with normal
    float sinT2 = (n1/n2)*(n1/n2) * (1.0 - cosI*cosI); // sin²(θ2) via Snell's law

    if (sinT2 > 1.0) return vec3(0.0);           // total internal reflection — no refracted ray

    float cosT = sqrt(1.0 - sinT2);              // cos(θ2)

    // assemble: tangential part + normal part
    return (n1/n2)*d + (n1/n2*cosI - cosT)*normal;
}

float intersectSphere(vec3 origin, vec3 dir, vec3 center, float r) {
    float eps = 0.01;
    vec3 oc = origin - center;
    float a = 1.0;
    float b = 2.0 * dotProduct(dir, oc);
    float c = dotProduct(oc, oc) - r * r;
    //determinanta
    float D = b * b - 4 * a * c;
    if (D < 0.0) return -1.0;
    //resevanje kvadratne enacbe
    float t1 = (-b - sqrt(D))/(2.0 * a);
    float t2 = (-b + sqrt(D))/(2.0 * a);
    //izloci tocke ki so za zarkom
    if (t1 > eps) return t1;
    if (t2 > eps) return t2;
    return -1.0;
}

float vectorDtance(vec3 a, vec3 b){
    return sqrt(abs(dotProduct(a-b, a-b)));
}

void main() {

    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(coord) / u_resolution;
    // sample input with filtering — uv is [0,1] across the image
    vec4 inputColor = texture(u_input, uv);


    vec4 color_accumulator = vec4(0.0, 0.0, 0.0, 0.0);

    //---------------------------------------------------------------------------------------------
    //cast ray
    //---------------------------------------------------------------------------------------------

    vec3 rayDir = vec3(0.0, 0.0, 1.0);
    vec3 rayOrigin = vec3(0.0 + uv.x * screenSize, 0.0 + uv.y * screenSize, 0.0);
    vec3 lensPosCenter = vec3(screenSize/2.0, screenSize/2.0, u_a);
    vec3 imagePos = vec3(0.0, 0.0, u_b + u_a);

    //---------------------------------------------------------------------------------------------
    //ray tracing
    //---------------------------------------------------------------------------------------------

    // najde t prvega zadetka z sfero
    // P(t) = t * d + o

    float t;
    vec3 sphereHit;
    vec3 surfaceNormal;
    vec3 rayDirNew;
    vec4 color;
    int hitCount = 0;

    for(int i = 0; i < 2; i++){  // only 2 refractions needed
        t = intersectSphere(rayOrigin, rayDir, lensPosCenter, u_r);
        if(t <= 0.0) break;

        sphereHit = t * rayDir + rayOrigin;
        surfaceNormal = normalize(sphereHit - lensPosCenter);
        rayDir = refractRay(rayDir, surfaceNormal, i == 0 ? 1.0 : u_n, i == 0 ? u_n : 1.0);
        rayOrigin = sphereHit;
    }

    // sample screen after exiting the lens
    float t_plate = (u_b - rayOrigin.z) / rayDir.z;
    vec3 screenHit = t_plate * rayDir + rayOrigin;
    if(screenHit.x >= 0.0 && screenHit.x <= objectSize && screenHit.y >= 0.0 && screenHit.y <= objectSize) //pogoj da trofi dejanso sliko ne pa neskonci plane
    color = texture(u_input, screenHit.xy/objectSize);
    else
    color = vec4(0.0);


    //---------------------------------------------------------------------------------------------
    //refraction
    //---------------------------------------------------------------------------------------------

    //---------------------------------------------------------------------------------------------
    //hits image
    //---------------------------------------------------------------------------------------------

    //accumulate color
    imageStore(outputImage, coord, color);

}