// shaders/raytrace.comp
#version 430 core

layout(local_size_x = 16, local_size_y = 16) in;
layout(rgba32f, binding = 0) uniform image2D outputImage;
uniform sampler2D u_input;

uniform float u_r;           // sphere radius
uniform float u_n;           // refractive index
uniform float u_a;           // source plane distance
uniform float u_b;           // screen distance
uniform vec2  u_resolution;

const float screenSize = 1.0;

float dotProduct(vec3 a, vec3 b){
    return 1.0 * (a.x * b.x + a.y * b.y + a.z * b.z);
}

float intersectSphere(vec3 origin, vec3 dir, vec3 center, float r) {
    float eps = 0.01;
    vec3 oc = origin - center;
    float a = 1.0;
    float b = 2.0 * dotProduct(dir, oc);
    float c = dotProduct(oc, oc) - r*r;
    //determinanta
    float D = b * b - 4 * a * c;
    if (D < 0.0) return -1.0;
    //resevanje kvadratne enacbe
    float t1 = (-b - sqrt(D))/(2.0 * a);
    float t2 = (-b + sqrt(D))/(2.0 * a);
    //izloci tocke ki so za zarkom
    if (t1 > eps) return t1;
    if (t2 > eps) return t2;
    return -1.0;
}

float vectorDtance(vec3 a, vec3 b){
    return sqrt(abs(dotProduct(a-b, a-b)));
}

void main() {

    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = vec2(coord) / u_resolution;
    // sample input with filtering — uv is [0,1] across the image
    vec4 inputColor = texture(u_input, uv);


    vec4 color_accumulator = vec4(0.0, 0.0, 0.0, 0.0);

    //---------------------------------------------------------------------------------------------
    //cast ray
    //---------------------------------------------------------------------------------------------

    vec3 rayDir = vec3(0.0, 0.0, 1.0);
    vec3 rayOrigin = vec3(0.0 + uv.x * screenSize, 0.0 + uv.y * screenSize, 0.0);
    vec3 lensPosCenter = vec3(0.5, 0.5, u_a);
    vec3 imagePos = vec3(0.0, 0.0, u_b + u_a);

    //---------------------------------------------------------------------------------------------
    //ray tracing
    //---------------------------------------------------------------------------------------------

    // najde t prvega zadetka z sfero
    // P(t) = t * d + o

    float t_prvi = intersectSphere(rayOrigin, rayDir, lensPosCenter, u_r);
    vec3 rayOriginNEW = t_prvi * rayDir + rayOrigin;
    float distanceTraveled = vectorDtance(rayOriginNEW, rayOrigin);
    if(t_prvi > 0.0){
        color_accumulator.xyz += vec3(0.5, 0.0, 0.0);
        //new ray:
        vec3 rayDirNEW = vec3(0.0, 0.0, 1.0); //todo naredi lom

    }
    if(t_prvi < 0.0){
        color_accumulator.xyz += vec3(1.0, 1.0, 1.0);
    }

    //template za tocko ki trofi screen
    float t_plate_unaltered = (u_b - rayOrigin.z)/rayDir.z;
    vec3 screenHit = t_plate_unaltered*rayDir + rayOrigin;
    vec4 color = texture(u_input,screenHit.xy);


    //---------------------------------------------------------------------------------------------
    //refraction
    //---------------------------------------------------------------------------------------------

    //---------------------------------------------------------------------------------------------
    //hits image
    //---------------------------------------------------------------------------------------------


    //accumulate color
    imageStore(outputImage, coord, color);

}